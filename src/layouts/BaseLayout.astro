---
/**
 * [WHY]: 全站唯一 HTML 壳——负责 title/meta/canonical/OG 等 SEO 头部与导航、页脚。
 * [INPUT]: 每个页面传入 title、description（meta 用）、canonicalPath（规范链接路径）；环境变量 PUBLIC_GSC_VERIFICATION（GSC 验证 token）、PUBLIC_GA4_ID（GA4 Measurement ID）、PUBLIC_PVUV_SITE_ID（pvuv.ai 统计站点 ID）。
 * [OUTPUT]: 完整 HTML 文档；玻璃感 sticky 导航（品牌块 + 链接 + Pack CTA）与页脚；og:image/twitter 大图卡（public/images/og-ai-rap-video.jpg）；条件注入 GSC 验证 meta、GA4 gtag 与 pvuv 统计脚本（未配置即零输出）。
 * [BOUND]: 不注入页面级 JSON-LD（由页面经 JsonLd 组件自行添加）；不做主题切换；移动端收起 nav-links（页脚有全量链接兜底）；GA4/pvuv 仅生产构建注入。
 * [PROTOCOL]: 新增导航入口或 meta 字段时更新各页面 Props 传参。
 */
import '../styles/global.css';
interface Props { title: string; description: string; canonicalPath?: string }
const { title, description, canonicalPath = '/' } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://ai-rap-video.wiki';
const canonical = `${site}${canonicalPath.startsWith('/') ? canonicalPath : '/' + canonicalPath}`;
// 统计与站长工具均条件渲染：环境变量未配置时不输出任何脚本或 meta
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
// GA4 仅生产构建注入，避免本地开发污染统计数据
const gaId = import.meta.env.PROD ? import.meta.env.PUBLIC_GA4_ID : undefined;
// pvuv.ai 统计与 GA4 同一套开关逻辑：仅生产构建注入
const pvuvSiteId = import.meta.env.PROD ? import.meta.env.PUBLIC_PVUV_SITE_ID : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI Rap Video Wiki" />
    <meta property="og:image" content={`${site}/images/og-ai-rap-video.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Two performers trading bars into a hanging studio mic under blue and orange stage light — AI rap video reference still." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/images/og-ai-rap-video.jpg`} />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    {pvuvSiteId && (
      <script is:inline defer src="https://www.pvuv.ai/f.js" data-site={pvuvSiteId} data-api="https://in.pvuv.ai"></script>
    )}
  </head>
  <body>
    <header class="site-header"><div class="wrap nav">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">AI</span>Rap Video</a>
      <nav class="nav-links" aria-label="Main">
        <a href="/prompts/">Prompts</a>
        <a href="/examples/">Examples</a>
        <a href="/how-to-make-ai-rap-video/">How-to</a>
        <a href="/ai-rap-video-vs-hotel-lobby-trend/">Compare</a>
      </nav>
      <a class="btn btn-sm nav-cta" href="/pack/">Get the Pack</a>
    </div></header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer"><div class="wrap footer-inner">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">AI</span>Rap Video</a>
      <nav class="footer-links" aria-label="Footer">
        <a href="/prompts/">Prompts</a>
        <a href="/examples/">Examples</a>
        <a href="/how-to-make-ai-rap-video/">How-to</a>
        <a href="/ai-rap-video-vs-hotel-lobby-trend/">Compare</a>
        <a href="/pack/">Pack</a>
      </nav>
      <p class="footer-note">Open-source AI Rap Video prompt templates. Not a paid generator. Original staging &amp; lyrics only.</p>
      <p class="footer-note">MIT · GitHub PNGTRID/ai-rap-video-wiki</p>
    </div></footer>
  </body>
</html>

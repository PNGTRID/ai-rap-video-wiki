---
/**
 * [WHY]: 全站唯一 HTML 壳——负责 title/meta/canonical/OG 等 SEO 头部与导航、页脚。
 * [INPUT]: 每个页面传入 title、description（meta 用）、canonicalPath（规范链接路径）。
 * [OUTPUT]: 完整 HTML 文档；页面插槽内容渲染在 main.wrap 内。
 * [BOUND]: 不注入页面级 JSON-LD（由页面经 JsonLd 组件自行添加）；不做主题切换。
 * [PROTOCOL]: 新增导航入口或 meta 字段时更新各页面 Props 传参。
 */
import '../styles/global.css';
interface Props { title: string; description: string; canonicalPath?: string }
const { title, description, canonicalPath = '/' } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://ai-rap-video.wiki';
const canonical = `${site}${canonicalPath.startsWith('/') ? canonicalPath : '/' + canonicalPath}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI Rap Video Wiki" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <header class="site-header"><div class="wrap nav">
      <a class="brand" href="/">AI Rap Video</a>
      <a href="/prompts/">Prompts</a>
      <a href="/how-to-make-ai-rap-video/">How-to</a>
      <a href="/ai-rap-video-vs-hotel-lobby-trend/">Compare</a>
      <a href="/pack/">Pack</a>
    </div></header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer"><div class="wrap" style="padding:1.25rem 0 2rem;">
      <p class="muted">Open-source AI Rap Video prompt templates. Not a paid generator. Original staging &amp; lyrics only.</p>
      <p class="muted">MIT · GitHub PNGTRID/ai-rap-video-wiki</p>
    </div></footer>
  </body>
</html>

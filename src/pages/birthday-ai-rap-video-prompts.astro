  description: 'Birthday AI rap video prompts for duo booth clips: scene structure, original toast-style bars, photo prep, and negatives — a template guide, not a paid video generator.',
  url: 'https://ai-rap-video.wiki/birthday-ai-rap-video-prompts/',
  isPartOf: { '@type': 'WebSite', name: 'AI Rap Video Wiki', url: 'https://ai-rap-video.wiki/' },
  license: 'https://opensource.org/licenses/MIT',
  inLanguage: 'en'
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AI Rap Video', item: 'https://ai-rap-video.wiki/' },
    { '@type': 'ListItem', position: 2, name: 'Birthday AI Rap Video Prompts', item: 'https://ai-rap-video.wiki/birthday-ai-rap-video-prompts/' }

 * [BOUND]: 本站不渲染、不是付费出片；强调原创 birthday bars，不商用绑定原曲与名人脸。
 * [PROTOCOL]: 改场景结构时对照 duo / original-lyrics 模板；伪 slug 'birthday' 在 videos.ts 维护。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import VideoGallery from '../components/VideoGallery.astro';
import { videosFor } from '../data/videos';

const faqs = [
  {
    q: 'Can this site generate a birthday AI rap video for me?',
    a: 'No. This is a prompt template wiki, not a paid outpainting or render service. You write (or adapt) birthday bars here, then render in an image-to-video model you already use.'
  },
  {
    q: 'What should birthday bars talk about?',
    a: 'Concrete, permissioned details: age milestone, shared memory, a nickname, a toast to the year ahead. Keep it original — never paste commercial song lyrics into the prompt.'
  },
  {
    q: 'Whose photos do I use?',
    a: 'The birthday person plus a friend or partner who consented, or two outfits of one person as a self-duo. Follow the photo prep checklist before you upload to your model.'
  },
  {
    q: 'Is a birthday clip different from the normal duo template?',
    a: 'The stage and camera language stay the same. What changes is the lyric block: birthday hooks and toast-style call-and-response instead of generic flex bars. The duo prompt plus the original lyrics prompt cover both layers.'
  },
  {
    q: 'Can I use a famous birthday song or a celebrity face?',
    a: 'Do not. Protected recordings and celebrity likenesses get clips muted or taken down. Original staging and original bars are the only path this wiki supports.'
  }
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
